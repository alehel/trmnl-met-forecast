{% assign today = "now" | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%d" %}
{% assign tomorrow = "now" | date: "%s" | plus: trmnl.user.utc_offset | plus: 86400 | date: "%Y-%m-%d" %}

{% template x_header %}
<div class="wx-head">
  <span class="wx-head-day" data-day-key="{{ key }}">{{ label }}</span>
  {% if date %}<span class="wx-head-date">{{ date }}</span>{% endif %}
</div>
{% endtemplate %}

{% template x_row %}
<div class="wx-row{% if highlight %} wx-row--now{% endif %}" data-code="{{ symbol_code }}">
  <span class="wx-row-time">{{ time_label }}</span>
  <img class="weather-icon wx-row-icon" />
  <span class="wx-row-temp">{{ temp }}{% if temp2 and temp2 != temp %}<small>/{{ temp2 }}°</small>{% else %}°{% endif %}</span>
  <span class="wx-row-precip">{% if precip > 0 %}{{ precip }}{{ precip_unit }}{% endif %}</span>
  <span class="wx-row-wind">{{ wind }}{{ wind_unit }}</span>
</div>
{% endtemplate %}

